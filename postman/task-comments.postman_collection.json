          }
        },
        {
          "name": "Owner deletes member's comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Owner deletes member's comment -> 200\", () => pm.response.to.have.status(200));"
