{
  "info": {
    "name": "WorkspaceHub - Task Comments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl, taskId and ownerToken/adminToken/memberToken (from POST /api/auth/login with the seed users), then run the collection."
  },
  "item": [
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Owner creates comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Owner creates comment -> 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ownerCommentId\", pm.response.json().data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Owner comment\"}"
            }
          }
        },
        {
          "name": "Member creates own comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Member creates own comment -> 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"memberCommentId\", pm.response.json().data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Member comment\"}"
            }
          }
        },
        {
          "name": "Member lists comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Member lists comments -> 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments"
          }
        },
        {
          "name": "Member edits own comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Member edits own comment -> 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{memberCommentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Edited by member\"}"
            }
          }
        },
        {
          "name": "Member edits owner's comment (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Member edits owner's comment (403) -> 403\", () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{ownerCommentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"hijack\"}"
            }
          }
        },
        {
          "name": "Member deletes owner's comment (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Member deletes owner's comment (403) -> 403\", () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{ownerCommentId}}"
          }
        },
        {
          "name": "Admin edits member's comment",
